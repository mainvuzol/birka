# Copy to infra/.env and fill in. NEVER commit the filled file.
# Generate the session secret with at least 32 bytes, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# On a server: .ai/project-memory/server-runbook.md, step 2.

# `production` on a server, and the default when the line is missing: the API
# then refuses to start without the bot token or with a session secret under
# 32 bytes, and hides its API docs. `local` only on a developer's computer.
BIRKA_APP_ENV=production
# The bare domain, e.g. birka.example.com (localhost on a laptop). Caddy gets
# its certificate; should renewing fail, backup-watch has the bot tell the
# owner a week before it runs out.
BIRKA_DOMAIN=localhost

POSTGRES_USER=birka
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=birka
# The password of `birka_app`, the role the API and backup-watch connect as:
# rows only, never the schema (ADR-0016). Long and random, at least 32
# characters: `openssl rand -base64 32`. Empty, compose refuses to start;
# `scripts.app_role` gives it to the role (server-runbook.md, step 3).
BIRKA_APP_DB_PASSWORD=

BIRKA_TELEGRAM_BOT_TOKEN=
BIRKA_SESSION_SECRET=
BIRKA_SENTRY_DSN=

# The owner's age public key (age1…). Without it every nightly backup fails:
# copies leave the server only encrypted (backup-restore-runbook.md).
BIRKA_BACKUP_AGE_RECIPIENTS=

# Trouble on the server (the app or its database not answering, the disk
# nearly full, nobody able to sign in) goes by the bot to the owner and to
# these administrators: Telegram user ids, comma-separated, each after they
# pressed «Start» in the bot (owner decision, 2026-10-03). Empty: the owner only.
BIRKA_ADMIN_TELEGRAM_IDS=
# The outside service backup-watch checks in with every 10 minutes, so a
# server dead whole is noticed too (the owner's account). Empty: none.
BIRKA_HEARTBEAT_URL=

# The build's version is not set here: export it in the shell before
# building, `export BIRKA_RELEASE=$(git rev-parse --short HEAD)`
# (server-runbook.md). Unset, the images say `dev`.
# BIRKA_RELEASE=
